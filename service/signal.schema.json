  "required": [
    "schema_version",
    "media_type",
    "signal_id",
    "seq",
    "emitted_at",
    "source",
    "as_of",
    "period",
    "filer",
    "assessment",
    "flags",
    "gate",
    "provenance",
    "run",
    "validation"
