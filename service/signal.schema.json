{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerline.invalid/schema/signal/1.0.0.json",
  "title": "Ledgerline signal record",
  "description": "Generated by `ledgerline contract-schema`; do not edit by hand. Version 1.0.0. The validation block is a required field: a consumer cannot receive a score without receiving the fact that the detector failed its own pre-registered test on 2026-08-30.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "signal_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "emitted_at": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "scan",
        "score",
        "emit",
        "replay"
      ]
    },
    "as_of": {
      "type": "string"
    },
    "period": {
      "type": [
        "string",
        "null"
      ]
    },
    "filer": {
      "type": "object",
      "properties": {
        "cik": {
          "type": "string"
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cik",
        "ticker"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "fired",
            "quiet",
            "unscoreable"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "n_flags": {
          "type": "integer"
        }
      },
      "required": [
        "state",
        "score",
        "reason",
        "reason_code",
        "n_flags"
      ],
      "additionalProperties": false
    },
    "flags": {
      "type": "array"
    },
    "gate": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "validation_status": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "validation_status"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "accessions": {
          "type": "array"
        },
        "derived_fraction": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "accessions",
        "derived_fraction"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "scored_on": {
          "type": "string"
        },
        "measured": {
          "type": "object"
        },
        "statement": {
          "type": "string"
        },
        "writeup": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "verdict",
        "scored_on",
        "measured",
        "statement",
        "writeup"
      ],
      "additionalProperties": false
    }
